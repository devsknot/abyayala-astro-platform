# Variables para scripts locales (scripts/upload-to-r2.js, purge-cache.js).
# El sitio NO las usa: en Cloudflare accede a R2 y D1 mediante bindings (wrangler.toml).
# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.

# Credenciales S3 de R2 (dash.cloudflare.com → R2 → Manage API tokens)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=abyayala-media

# Para purge-cache.js
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

ENVIRONMENT=development
