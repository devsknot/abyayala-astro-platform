{
  "name": "abyayala-astro-platform",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler pages dev dist",
    "check": "astro check",
    "astro": "astro",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply abyayala-cms --local",
    "db:migrate:remote": "wrangler d1 migrations apply abyayala-cms --remote",
    "db:migrations:list": "wrangler d1 migrations list abyayala-cms --remote",
    "db:studio": "drizzle-kit studio",
    "deploy": "npm run build && wrangler pages deploy dist --project-name abyayala-astro-platform --branch main",
    "db:seed:local": "wrangler d1 execute abyayala-cms --local --file scripts/seed-local.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.4.1",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.3.0",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.5.6",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "tailwindcss": "^3.4.17",
    "xss": "^1.0.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^4.20260702.1",
    "drizzle-kit": "^0.31.11",
    "node-fetch": "^3.3.2",
    "sharp": "^0.34.1",
    "typescript": "^5.9.3",
    "wrangler": "^3.114.17"
  }
}
