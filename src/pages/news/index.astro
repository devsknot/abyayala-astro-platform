<script>
  // La búsqueda la resuelve el servidor; aquí solo se envía el formulario al cambiar la categoría.
  const form = document.getElementById('archive-search') as HTMLFormElement | null;
  form?.querySelectorAll<HTMLSelectElement>('[data-autosubmit]').forEach((el) => {
    el.addEventListener('change', () => form.requestSubmit());
  });
  // URLs limpias: no se envían los campos vacíos.
  form?.addEventListener('submit', () => {
    form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[name]').forEach((el) => {
      if (!el.value) el.disabled = true;
    });
  });
  // Al volver con el botón atrás, el formulario puede restaurarse con campos deshabilitados.
  window.addEventListener('pageshow', () => {
    form?.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[name]').forEach((el) => (el.disabled = false));
  });
</script>
